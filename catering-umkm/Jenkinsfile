pipeline {
  agent any
  triggers { pollSCM('* * * * *') }   // cek GitHub tiap menit -> otomatis jalan setelah push
  environment {
    DB_HOST = 'localhost'
    DB_USER = 'root'
    DB_PASS = ''
  }
  stages {
    stage('Checkout') {
      steps { git branch: 'main', url: 'https://github.com/USERNAME/catering-umkm.git' }
    }
    stage('Install') {
      steps { sh 'python3 -m venv venv && . venv/bin/activate && pip install -r requirements.txt' }
    }
    stage('Test') {
      steps { sh '. venv/bin/activate && python -m pytest -q' }
    }
    stage('Deploy') {
      steps {
        sh '''
          pkill -f "python app.py" || true
          . venv/bin/activate
          JENKINS_NODE_COOKIE=dontKillMe nohup python app.py > app.log 2>&1 &
        '''
      }
    }
  }
  post {
    success { echo 'Build & deploy berhasil ✅' }
    failure { echo 'Build gagal ❌ - cek Console Output' }
  }
}
